{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",

    /* Node globals (`process`, `require`, ...). Without a tsconfig the editor
       falls back to an inferred project that may not pick up @types/node. */
    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Playwright transpiles the specs itself; tsc only type-checks. */
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report", "blob-report"]
}
